class Solution {
    int missingNum(int arr[]) {
        // code here
        int n = arr.length+1;
        int actual_count = 0;
        int expected_count = 0;
        for(int i=0;i<arr.length;i++){
            actual_count += arr[i];
        }
        for(int i=1;i<=n;i++){
            expected_count += i;
        }
        int res = expected_count - actual_count;
        return res;
    }
}
